#!/bin/bash

# Creates a day's directory with ts file and txt file to dump the input

if [ -z "$1" ]; then
  echo "Usage: run <day>"
  exit 1
fi

DAY=$(printf "%02d" "$1")
DIR="day${DAY}"

# Creates the directory if it doesnt already exist
if [ -d "$DIR" ]; then 
  echo "Directory already exists blud 💀"
else 
  echo "Creating directory 🤓..."
  mkdir "$DIR"
fi

# Creates input if its missing
if [ -f "$DIR/input.txt" ]; then
  echo "Input files already there 😅"
else 
  echo "Creating input file..."
  touch "$DIR/input.txt"
fi

# Creates input file with starter code if its not there
if [ -f "$DIR/index.ts" ]; then
  echo "Codes already in the house my man"
else 
  echo "Creating code file..."
  touch "$DIR/index.ts"
  echo -e "import readInput from \"../utils/readInput.js\"\n\nconst input = readInput($1);" > "$DIR/index.ts"
fi

echo "All good sigma. Time to grind ✅💰💵"